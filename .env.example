# Copy this file to .env and fill in your API keys.
# .env is never committed (see .gitignore).
# For local dev: cp .env.example .env
# For the Docker build on your server, deploy.sh copies this if .env is missing.

VITE_WEATHER_BASE_URL=https://api.openweathermap.org/data/3.0/onecall
VITE_GEOCODE_BASE_URL=https://api.geoapify.com/v1/geocode/search
VITE_WEATHER_API_KEY=your-openweathermap-key
VITE_GEOCODE_API_KEY=your-geoapify-key
